{
	"name": "@zupy/icons",
	"version": "0.0.0",
	"description": "Tactile SVG icons for zupy: chunky outlines, solid fills and a hard drop shadow.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zupy-ui/zupy.git",
		"directory": "packages/icons"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"react": "^19"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@zupy/config": "workspace:*",
		"react": "^19.3.1",
		"tsdown": "^0.23.4"
	}
}
