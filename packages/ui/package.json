{
	"name": "@zupy/ui",
	"version": "0.0.0",
	"description": "Playful, tactile React components. Chunky edges, hard shadows, springy motion.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zupy-ui/zupy.git",
		"directory": "packages/ui"
	},
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"scripts": {
		"build": "tsdown && cp src/styles.css dist/styles.css",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@zupy/tokens": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.7.0"
	},
	"peerDependencies": {
		"react": "^19",
		"react-dom": "^19",
		"tailwindcss": "^4"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@zupy/config": "workspace:*",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwindcss": "^4.3.3",
		"tsdown": "^0.23.4"
	}
}
